<?xml version="1.0" encoding="utf-8"?>
<!-- Subscription downloads and update checks also trust CAs the user installed (e.g. a corporate proxy), like the cores do. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
